###################################################################

# Created by write_sdc on Tue Sep 15 10:09:28 2026

###################################################################
set sdc_version 1.7

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current uA
set_max_delay 4.25  -to [get_ports {f_out[15]}]
set_max_delay 4.25  -to [get_ports {f_out[14]}]
set_max_delay 4.25  -to [get_ports {f_out[13]}]
set_max_delay 4.25  -to [get_ports {f_out[12]}]
set_max_delay 4.25  -to [get_ports {f_out[11]}]
set_max_delay 4.25  -to [get_ports {f_out[10]}]
set_max_delay 4.25  -to [get_ports {f_out[9]}]
set_max_delay 4.25  -to [get_ports {f_out[8]}]
set_max_delay 4.25  -to [get_ports {f_out[7]}]
set_max_delay 4.25  -to [get_ports {f_out[6]}]
set_max_delay 4.25  -to [get_ports {f_out[5]}]
set_max_delay 4.25  -to [get_ports {f_out[4]}]
set_max_delay 4.25  -to [get_ports {f_out[3]}]
set_max_delay 4.25  -to [get_ports {f_out[2]}]
set_max_delay 4.25  -to [get_ports {f_out[1]}]
set_max_delay 4.25  -to [get_ports {f_out[0]}]
set_max_delay 4.25  -to [get_ports {nz_out[1]}]
set_max_delay 4.25  -to [get_ports {nz_out[0]}]
