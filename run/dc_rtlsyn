#!/bin/csh

set DESIGN_NAME = `scripts/get_variable.tcl DESIGN_NAME >& /dev/null ; cat output/variable`
if ( $DESIGN_NAME == "") then
    echo "Error: Variable DESIGN_NAME has not been set in input/0_setup_design.tcl."
    exit
endif

source run/setup_env.csh

cd $WORKDIR

rm -f *.ddc >& /dev/null

dc_shell -f scripts/dc_rtlsyn.tcl

set log = reports/${DESIGN_NAME}.rtl.synthesis_log.txt

echo "-----------------------------------------------------------------------------------------"
echo "Errors and warnings in log file:"
echo "-----------------------------------------------------------------------------------------"
if ( -f $log ) then
    grep -n '^Error:' $log
    grep -n '^Warning:' $log
endif
echo "-----------------------------------------------------------------------------------------"

cd ..

source run/cleanup_env.csh



