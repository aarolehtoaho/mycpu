#!/bin/csh

set DESIGN_NAME = `scripts/get_variable.tcl DESIGN_NAME >& /dev/null ; cat output/variable`
if ( $DESIGN_NAME == "") then
    echo "Error: Variable DESIGN_NAME has not been set in input/0_setup_design.tcl."
    exit
endif

if ( $#argv != 1 ) then
   echo "Usage: run/vsim_ins INSTRUCTION"
   exit
endif

set ins = $1

if ( ! -f input/asm/${ins}.asm ) then
   echo "Error: File ${ins} does not exist. Check instruction name."
   exit
endif

source run/setup_env.csh

run/asm ${ins}.asm
run/vsim_rtlsim
cp reports/mycpu_simulation.txt reports/mycpu_simulation.${ins}.txt
cp reports/mycpu_memory.txt reports/mycpu_memory.${ins}.txt    
cp reports/mycpu.rtl.simulation_log.txt reports/mycpu.rtl.simulation_log.{ins}.txt

source run/cleanup_env.csh

